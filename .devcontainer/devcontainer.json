{
  "name": "Kivy starter",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": { "password": "noPassword" }
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": { "label": "Your app's window", "onAutoForward": "openPreview" }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends libgl1 libegl1 libgles2 libmtdev1 && pip install --no-cache-dir 'kivy[base]'",
  "containerEnv": { "DISPLAY": ":1" },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": { "python.defaultInterpreterPath": "/usr/local/bin/python" }
    }
  }
}
